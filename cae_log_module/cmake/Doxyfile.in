PROJECT_NAME           = "cae_logger"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "Structured CAE logging library"
OUTPUT_DIRECTORY       = "@CAE_LOGGER_DOXYGEN_OUTPUT_DIR@"
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = NO
OUTPUT_LANGUAGE        = English

INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/src/cae_logger.h" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/src/cae_log_builder.h" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/src/cae_logger_types.h" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/src/cae_event_schema.h" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/src/cae_task_scope.h" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/src/cae_scoped_timer.h" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/user_document.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/cae_logger_macro_guide.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/user_document_verification.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs/CAE_LOG_SCOPE.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/rule/cae_log_specification.md"
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/docs/user_document.md"
FILE_PATTERNS          = *.h *.md
RECURSIVE              = NO
EXCLUDE                = "@CMAKE_CURRENT_SOURCE_DIR@/thirdparty" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/build" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/install"

MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 5
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
BUILTIN_STL_SUPPORT    = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = CAE_LOGGER_EXPORT= \
                         CAE_LOGGER_NO_EXPORT=

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_TAGFILE       =

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
