@PACKAGE_INIT@

set(_CAE_LOGGER_SPDLOG_TARGET "@CAE_SPDLOG_TARGET@")

if(_CAE_LOGGER_SPDLOG_TARGET AND NOT TARGET "${_CAE_LOGGER_SPDLOG_TARGET}")
    find_package(spdlog REQUIRED CONFIG)
endif()

if(_CAE_LOGGER_SPDLOG_TARGET AND NOT TARGET "${_CAE_LOGGER_SPDLOG_TARGET}")
    message(FATAL_ERROR "cae_logger requires ${_CAE_LOGGER_SPDLOG_TARGET}, but the target was not found.")
endif()

unset(_CAE_LOGGER_SPDLOG_TARGET)

include("${CMAKE_CURRENT_LIST_DIR}/cae_loggerTargets.cmake")
