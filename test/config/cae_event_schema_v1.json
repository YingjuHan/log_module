{
  "schema_version": "cae_event_v1",
  "format": "jsonl",
  "description": "Authoritative registry for CAE event JSONL rows and tabular exports.",
  "required_string_fields": [
    "timestamp",
    "date",
    "time",
    "source",
    "component",
    "stage",
    "action",
    "level",
    "message",
    "event_kind",
    "trace_id",
    "span_id",
    "session",
    "thread_name",
    "schema_version",
    "event_id",
    "event_type",
    "phase",
    "domain",
    "entity_type",
    "entity_name",
    "job_id",
    "global_sequence_id"
  ],
  "required_integer_fields": [
    "duration_us",
    "size",
    "sequence",
    "logical_time",
    "timestamp_epoch_us",
    "monotonic_us"
  ],
  "nullable_string_fields": [
    "parent_span_id",
    "parent_event_id",
    "object_type",
    "object_name",
    "result",
    "reason"
  ],
  "enums": {
    "event_type": [
      "geometry",
      "mesh",
      "solve",
      "io",
      "ui",
      "mpi",
      "postprocess",
      "system",
      "unknown"
    ],
    "phase": [
      "start",
      "progress",
      "end",
      "unknown"
    ],
    "domain": [
      "cfd",
      "fem",
      "pre",
      "post",
      "system",
      "unknown"
    ]
  },
  "column_types": {
    "schema_version": "string",
    "timestamp": "string",
    "timestamp_epoch_us": "uint64",
    "monotonic_us": "uint64",
    "date": "string",
    "time": "string",
    "source": "string",
    "component": "string",
    "stage": "string",
    "action": "string",
    "level": "string",
    "message": "string",
    "event_kind": "enum:point|span",
    "event_type": "enum:event_type",
    "phase": "enum:phase",
    "domain": "enum:domain",
    "entity_type": "string",
    "entity_name": "string",
    "duration_us": "uint64",
    "size": "uint64",
    "session": "string",
    "job_id": "string",
    "thread_name": "string",
    "node_id": "string",
    "mpi_rank": "int32|null",
    "sequence": "uint64",
    "global_sequence_id": "string",
    "logical_time": "uint64",
    "trace_id": "hex32",
    "span_id": "hex16",
    "event_id": "hex16",
    "parent_span_id": "hex16|null",
    "parent_event_id": "hex16|null",
    "object_type": "string|null",
    "object_name": "string|null",
    "result": "string|null",
    "reason": "string|null",
    "call_chain_status": "string"
  },
  "export_columns": [
    "schema_version",
    "timestamp",
    "timestamp_epoch_us",
    "monotonic_us",
    "date",
    "time",
    "source",
    "component",
    "stage",
    "action",
    "level",
    "message",
    "event_kind",
    "event_type",
    "phase",
    "domain",
    "entity_type",
    "entity_name",
    "duration_us",
    "size",
    "session",
    "job_id",
    "thread_name",
    "node_id",
    "mpi_rank",
    "sequence",
    "global_sequence_id",
    "logical_time",
    "trace_id",
    "span_id",
    "event_id",
    "parent_span_id",
    "parent_event_id",
    "object_type",
    "object_name",
    "result",
    "reason",
    "call_chain_status"
  ],
  "metric_column_prefix": "metric_",
  "aliases": {
    "event_id": "span_id",
    "parent_event_id": "parent_span_id"
  },
  "ordering": {
    "primary": "parent_event_id",
    "tie_breakers": [
      "timestamp_epoch_us",
      "logical_time",
      "node_id",
      "mpi_rank",
      "source",
      "sequence"
    ]
  },
  "tool_roles": {
    "goaccess": "compatibility_reports_for_existing_cae_html_and_json_outputs_only",
    "tad": "tabular_exploration_via_csv_or_arrow_or_parquet_exports",
    "columnar": "preferred_cae_event_analysis_backend"
  }
}
